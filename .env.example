# 仅包含可公开的启动项和空的本机密钥槽；复制为 .env 后再填写，绝不提交 .env。
DATABASE_URL="file:./data/prod.db"
PORT=3000
APP_ORIGIN="http://127.0.0.1:3000"
RUN_DB_SEED=false
AI_PROVIDER=database

# 本机服务端密钥必须留空到部署者生成。AI_CONFIG_SECRET 用于 AES-256-GCM
# 加密管理员 UI 中保存的云端凭据，也用于签名后台会话。安全生成示例：
#   openssl rand -base64 48
AI_CONFIG_SECRET=
# 招聘 API 凭据和浏览器授权记录使用另一把至少 32 字符的独立随机密钥。
RECRUITMENT_SESSION_SECRET=
# 可选的应急 Basic Auth 必须成对设置；密码至少 12 字符。
# 留空时只使用 /setup 初始化的数据库超级管理员。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 百炼 API Key、灵眸 RAM AccessKey 和私有 OSS RAM AccessKey 只能通过
# 后台加密的管理员 UI 输入；不得新增明文云凭据环境变量或写入此文件。
