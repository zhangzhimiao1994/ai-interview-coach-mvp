DATABASE_URL="file:./data/prod.db"
PORT=3000
RUN_DB_SEED=false
AI_CONFIG_SECRET="change-this-before-production"
AI_PROVIDER=database
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-before-production"

# Set AI_PROVIDER=mock to force the local deterministic provider.
# AI_PROVIDER=mock

# 百炼 API Key 与灵眸 RAM AccessKey 均通过 AI 配置中心在后台加密保存，
# 不要把灵眸 RAM AccessKey 写入环境变量或此示例文件。
