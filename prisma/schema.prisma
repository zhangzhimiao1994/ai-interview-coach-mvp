generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Candidate {
  id            String            @id @default(cuid())
  name          String
  email         String?
  phone         String?
  targetCompany String?
  targetRole    String?
  serviceStatus String            @default("ACTIVE")
  weakTags      String            @default("[]")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  materials     MaterialAsset[]
  tasks         TrainingTask[]
  sessions      TrainingSession[]
  recruitmentTemplateBindings RecruitmentTemplateCandidate[]
}

model MaterialAsset {
  id          String     @id @default(cuid())
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  type        String
  title       String
  content     String
  source      String     @default("MANUAL")
  createdAt   DateTime   @default(now())

  @@index([candidateId])
}

model CompanyTemplate {
  id               String         @id @default(cuid())
  name             String
  industry         String?
  interviewStyle   String
  competencyModel  String
  commonQuestions  String
  scoringStandard  String
  restrictedTopics String         @default("[]")
  createdAt        DateTime       @default(now())
  tasks            TrainingTask[]
}

model JobTemplate {
  id              String         @id @default(cuid())
  title           String
  category        String
  competencyModel String
  commonQuestions String
  riskQuestions   String
  createdAt       DateTime       @default(now())
  tasks           TrainingTask[]
}

model InterviewerTemplate {
  id                 String         @id @default(cuid())
  type               String         @unique
  name               String
  tone               String
  followUpDepth      Int
  interruptFrequency Int
  challengeIntensity Int
  languageMode       String
  safetyBoundary     String
  createdAt          DateTime       @default(now())
  tasks              TrainingTask[]
}

model TrainingTask {
  id                    String               @id @default(cuid())
  candidateId           String
  candidate             Candidate            @relation(fields: [candidateId], references: [id])
  jobPostingId          String?
  jobPosting            RecruitmentJobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  companyTemplateId     String?
  companyTemplate       CompanyTemplate?     @relation(fields: [companyTemplateId], references: [id])
  jobTemplateId         String?
  jobTemplate           JobTemplate?         @relation(fields: [jobTemplateId], references: [id])
  interviewerTemplateId String?
  interviewerTemplate   InterviewerTemplate? @relation(fields: [interviewerTemplateId], references: [id])
  title                 String
  targetCompany         String
  targetRole            String
  jobSourceUrl          String?
  jobDescription        String?
  jobManualNotes        String?
  stageConfig           String
  expectedMinutes       Int
  status                String               @default("DRAFT")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  sessions              TrainingSession[]
  aiCalls               AiCallLog[]

  @@index([candidateId])
  @@index([jobPostingId])
  @@index([companyTemplateId])
  @@index([jobTemplateId])
  @@index([interviewerTemplateId])
}

model RecruitmentSource {
  id                   String                  @id @default(cuid())
  provider             String
  sourceType           String
  displayName          String
  enabled              Boolean                 @default(true)
  credentialCiphertext String?
  credentialIv         String?
  credentialTag        String?
  credentialPreview    String?
  sessionCiphertext    String?
  sessionIv            String?
  sessionTag           String?
  sessionPreview       String?
  verificationStatus   String                  @default("UNVERIFIED")
  lastVerifiedAt       DateTime?
  lastSuccessfulSyncAt DateTime?
  settingsJson         String                  @default("{}")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  postings             RecruitmentJobPosting[]
  syncRuns             RecruitmentSyncRun[]

  @@index([provider])
  @@index([sourceType])
  @@index([enabled])
  @@unique([provider, displayName])
}

model RecruitmentSearchTemplate {
  id              String                         @id @default(cuid())
  name            String
  keywords        String
  roleType        String?
  city            String?
  country         String?
  experienceRange String?
  salaryRange     String?
  language        String?
  remoteMode      String?
  sourceIdsJson   String                         @default("[]")
  enabled         Boolean                        @default(true)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  candidateLinks  RecruitmentTemplateCandidate[]
  schedules       RecruitmentSyncSchedule[]
  syncRuns        RecruitmentSyncRun[]

  @@index([enabled])
  @@index([country])
  @@index([city])
}

model RecruitmentTemplateCandidate {
  id         String                    @id @default(cuid())
  templateId String
  template   RecruitmentSearchTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt  DateTime                  @default(now())

  @@unique([templateId, candidateId])
  @@index([candidateId])
}

model RecruitmentSyncSchedule {
  id             String                    @id @default(cuid())
  templateId     String
  template       RecruitmentSearchTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  frequency      String
  nextRunAt      DateTime
  enabled        Boolean                   @default(true)
  lockExpiresAt  DateTime?
  lastRunAt      DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([templateId])
}

model RecruitmentSyncRun {
  id             String                     @id @default(cuid())
  sourceId       String?
  source         RecruitmentSource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  templateId     String?
  template       RecruitmentSearchTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  mode           String                     @default("MANUAL")
  status         String                     @default("PENDING")
  insertedCount  Int                        @default(0)
  updatedCount   Int                        @default(0)
  skippedCount   Int                        @default(0)
  failureReason  String?
  logsJson       String                     @default("[]")
  startedAt      DateTime                   @default(now())
  finishedAt     DateTime?
  createdAt      DateTime                   @default(now())

  @@index([sourceId])
  @@index([templateId])
  @@index([status])
  @@index([startedAt])
}

model RecruitmentJobPosting {
  id               String              @id @default(cuid())
  sourceId         String?
  source           RecruitmentSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  provider         String
  sourceType       String
  title            String
  company          String?
  location         String?
  salary           String?
  description      String
  requirementsJson String              @default("[]")
  sourceUrl        String?
  externalJobId    String?
  publishedAt      DateTime?
  rawJson          String?
  dedupeKey        String              @unique
  status           String              @default("ACTIVE")
  editedNotes      String?
  manualImport     Boolean             @default(false)
  firstSeenAt      DateTime            @default(now())
  lastSeenAt       DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  trainingTasks    TrainingTask[]

  @@unique([provider, externalJobId])
  @@index([sourceId])
  @@index([provider])
  @@index([sourceType])
  @@index([status])
  @@index([company])
  @@index([lastSeenAt])
}

model TrainingSession {
  id           String          @id @default(cuid())
  taskId       String
  task         TrainingTask    @relation(fields: [taskId], references: [id])
  candidateId  String
  candidate    Candidate       @relation(fields: [candidateId], references: [id])
  status       String          @default("IN_PROGRESS")
  currentStage String?
  outlineJson  String?
  startedAt    DateTime        @default(now())
  endedAt      DateTime?
  turns        SessionTurn[]
  report       CoachingReport?
  aiCalls      AiCallLog[]
  digitalHumanSessions DigitalHumanSession[]
  digitalHumanRenderJobs DigitalHumanRenderJob[]
  digitalHumanRenderPlaceholders DigitalHumanRenderPlaceholder[]

  @@index([taskId])
  @@index([candidateId])
}

model DigitalHumanSession {
  id                String          @id @default(cuid())
  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  closeRecovery     ProviderSessionCloseRecovery?
  providerId        String?
  modelId           String?
  adapter           String
  mode              String
  providerSessionId String?
  instanceId        String?
  providerConfigVersion Int?
  status            String          @default("CONNECTING")
  lastActivityAt    DateTime        @default(now())
  expiresAt         DateTime
  endedAt           DateTime?
  stopReason        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([trainingSessionId])
  @@index([status, lastActivityAt])
  @@index([providerSessionId])
}

model DigitalHumanRenderPlaceholder {
  id                  String          @id @default(cuid())
  trainingSessionId   String
  trainingSession     TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  questionId          String
  questionHash        String
  cacheKey            String
  kind                String
  stage               String
  questionText        String
  behaviorSignalsJson String?
  status              String          @default("PENDING")
  renderJobId         String?         @unique
  renderJob           DigitalHumanRenderJob? @relation("RenderPlaceholderJob", fields: [renderJobId], references: [id], onDelete: SetNull)
  audioAssetId        String?
  audioAsset          DigitalHumanMediaAsset? @relation("RenderPlaceholderAudio", fields: [audioAssetId], references: [id], onDelete: SetNull)
  runtimeSettingsJson String?
  renderCreatedAt     DateTime?
  deadlineAt          DateTime?
  claimToken          String?
  claimExpiresAt      DateTime?
  fallbackReason      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([trainingSessionId, questionId, cacheKey])
  @@index([trainingSessionId, status])
  @@index([claimExpiresAt])
  @@index([audioAssetId])
}

model MediaStorageConfig {
  id                     String                   @id @default(cuid())
  displayName            String
  providerKind           String
  endpoint               String
  bucket                 String
  region                 String?
  credentialsCiphertext  String?
  credentialsIv          String?
  credentialsTag         String?
  credentialsPreviewJson String?
  enabled                Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  assets                 DigitalHumanMediaAsset[]

  @@unique([providerKind, displayName])
  @@index([enabled])
}

model DigitalHumanMediaAsset {
  id                String                       @id @default(cuid())
  storageConfigId   String
  storageConfig     MediaStorageConfig           @relation(fields: [storageConfigId], references: [id], onDelete: Restrict)
  objectKey         String                       @unique
  mimeType          String
  byteLength        Int
  purpose           String
  expiresAt         DateTime?
  cleanupStatus     String                       @default("ACTIVE")
  cleanedAt         DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  portraitProfiles  InterviewerAvatarProfile[]   @relation("InterviewerAvatarPortrait")
  outputAttempts    DigitalHumanRenderAttempt[]
  inputAudioJobs    DigitalHumanRenderJob[]       @relation("RenderJobAudio")
  attemptPortraits  DigitalHumanRenderAttempt[]   @relation("RenderAttemptPortrait")
  placeholderAudio  DigitalHumanRenderPlaceholder[] @relation("RenderPlaceholderAudio")

  @@index([storageConfigId])
  @@index([cleanupStatus, expiresAt])
}

model InterviewerAvatarProfile {
  id                 String                  @id @default(cuid())
  displayName        String
  voice              String
  styleJson          String                  @default("{}")
  portraitAssetId    String?
  portraitAsset      DigitalHumanMediaAsset? @relation("InterviewerAvatarPortrait", fields: [portraitAssetId], references: [id], onDelete: SetNull)
  lingmouMappingJson String                  @default("{}")
  emoMappingJson     String                  @default("{}")
  providerRole       String
  enabled            Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  renderJobs         DigitalHumanRenderJob[]
  renderAttempts     DigitalHumanRenderAttempt[] @relation("RenderAttemptInterviewer")

  @@index([enabled])
  @@index([providerRole])
}

model DigitalHumanRenderJob {
  id                   String                      @id @default(cuid())
  trainingSessionId    String
  questionId           String
  questionHash         String
  cacheKey             String
  kind                 String
  mode                 String
  status               String                      @default("PENDING")
  interviewerProfileId String
  audioAssetId          String?
  audioAsset            DigitalHumanMediaAsset?       @relation("RenderJobAudio", fields: [audioAssetId], references: [id], onDelete: Restrict)
  planFingerprint       String                      @default("")
  deadlineAt           DateTime
  winnerAttemptId      String?
  winnerAttempt        DigitalHumanRenderAttempt? @relation("RenderJobWinner", fields: [winnerAttemptId], references: [id], onDelete: SetNull)
  fallbackReason       String?
  createdAt            DateTime                    @default(now())
  readyAt              DateTime?
  expiredAt            DateTime?
  updatedAt            DateTime                    @updatedAt

  trainingSession    TrainingSession             @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  interviewerProfile InterviewerAvatarProfile    @relation(fields: [interviewerProfileId], references: [id])
  attempts           DigitalHumanRenderAttempt[] @relation("RenderJobAttempts")
  placeholder        DigitalHumanRenderPlaceholder? @relation("RenderPlaceholderJob")

  @@unique([trainingSessionId, questionId, cacheKey])
  @@index([status, deadlineAt])
  @@index([audioAssetId])
  @@index([interviewerProfileId])
  @@index([winnerAttemptId])
}

model DigitalHumanRenderAttempt {
  id                   String                 @id @default(cuid())
  renderJobId          String
  providerKind         String
  providerId           String
  modelId              String
  interviewerName      String
  interviewerProfileId String?
  portraitAssetId      String?
  interviewerProfile  InterviewerAvatarProfile? @relation("RenderAttemptInterviewer", fields: [interviewerProfileId], references: [id], onDelete: Restrict)
  portraitAsset       DigitalHumanMediaAsset?    @relation("RenderAttemptPortrait", fields: [portraitAssetId], references: [id], onDelete: SetNull)
  status               String                 @default("PENDING")
  upstreamTaskId       String?
  traceId              String?
  nextPollAt           DateTime?
  submittedAt          DateTime?
  firstQueriedAt       DateTime?
  completedAt          DateTime?
  outputAssetId        String?
  outputUrlCiphertext  String?
  outputUrlIv          String?
  outputUrlTag         String?
  safeErrorCode        String?
  failureKind          String?
  queryAttemptCount    Int                    @default(0)
  cacheAttemptCount    Int                    @default(0)
  successObservedAt    DateTime?
  claimOperation       String?
  claimToken           String?
  claimExpiresAt       DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  renderJob   DigitalHumanRenderJob   @relation("RenderJobAttempts", fields: [renderJobId], references: [id], onDelete: Cascade)
  winnerForJobs DigitalHumanRenderJob[] @relation("RenderJobWinner")
  outputAsset DigitalHumanMediaAsset? @relation(fields: [outputAssetId], references: [id], onDelete: SetNull)

  @@unique([renderJobId, providerKind])
  @@index([status, nextPollAt])
  @@index([claimOperation, claimExpiresAt])
  @@index([interviewerProfileId])
  @@index([portraitAssetId])
}

model DigitalHumanVideoDiagnosticAudit {
  id                    String   @id @default(cuid())
  actorId               String
  providerKind          String
  status                String
  safeCode              String
  traceId               String?
  checkedAt             DateTime
  billingOperationsJson String
  costSemantics         String
  createdAt             DateTime @default(now())

  @@index([actorId, checkedAt])
  @@index([providerKind, checkedAt])
  @@index([status, checkedAt])
}

model SessionTurn {
  id        String          @id @default(cuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id])
  stage     String
  questionId String?
  question  String
  answer    String
  behaviorSignalsJson String?
  feedback  String?
  createdAt DateTime        @default(now())

  @@index([sessionId])
  @@unique([sessionId, questionId])
}

model CoachingReport {
  id                    String          @id @default(cuid())
  sessionId             String          @unique
  session               TrainingSession @relation(fields: [sessionId], references: [id])
  overallScore          Int
  subScores             String
  perQuestionFeedback   String
  expressionAnalysis    String
  answerQualityAnalysis String
  strategySuggestions   String
  weakTags              String
  nextTrainingPlan      String
  candidateSummary      String
  detailsJson           String          @default("{}")
  createdAt             DateTime        @default(now())
  aiCalls               AiCallLog[]
}

model AiCallLog {
  id               String           @id @default(cuid())
  taskId           String?
  task             TrainingTask?    @relation(fields: [taskId], references: [id])
  sessionId        String?
  session          TrainingSession? @relation(fields: [sessionId], references: [id])
  reportId         String?
  report           CoachingReport?  @relation(fields: [reportId], references: [id])
  capability       String
  provider         String
  latencyMs        Int
  costEstimate     Float
  success          Boolean
  failureReason    String?
  fallbackProvider String?
  createdAt        DateTime         @default(now())

  @@index([taskId])
  @@index([sessionId])
  @@index([reportId])
}

model AiServiceProvider {
  id                     String          @id @default(cuid())
  displayName            String
  providerType           String
  baseUrl                String?
  apiKeyCiphertext       String?
  apiKeyIv               String?
  apiKeyTag              String?
  apiKeyPreview          String?
  credentialsCiphertext  String?
  credentialsIv          String?
  credentialsTag         String?
  credentialsPreviewJson String?
  settingsJson           String          @default("{}")
  closeConfigVersion     Int             @default(0)
  enabled                Boolean         @default(true)
  notes                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  models                 AiModelConfig[]
  closeRecoveries        ProviderSessionCloseRecovery[]

  @@index([providerType])
  @@index([enabled])
}

model ProviderSessionCloseRecovery {
  id                    String            @id @default(cuid())
  providerId            String
  provider              AiServiceProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  digitalHumanSessionId String?           @unique
  digitalHumanSession   DigitalHumanSession? @relation(fields: [digitalHumanSessionId], references: [id], onDelete: SetNull)
  providerSessionId     String?
  instanceId            String
  providerConfigVersion Int
  reasonCode            String
  attemptCount          Int               @default(0)
  nextAttemptAt         DateTime          @default(now())
  claimExpiresAt        DateTime?
  lastErrorCode         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([providerId, providerSessionId, instanceId])
  @@index([nextAttemptAt])
  @@index([providerId])
}

model AiModelConfig {
  id           String            @id @default(cuid())
  providerId   String
  provider     AiServiceProvider @relation(fields: [providerId], references: [id])
  displayName  String
  modelName    String
  capability   String
  temperature  Float             @default(0.4)
  maxTokens    Int               @default(1200)
  timeoutMs    Int               @default(30000)
  costNote     String?
  settingsJson String            @default("{}")
  enabled      Boolean           @default(true)
  isDefault    Boolean           @default(false)
  isSelected   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([providerId])
  @@index([capability])
  @@index([enabled])
  @@index([isDefault])
  @@index([isSelected])
}

model AiRuntimeSetting {
  key       String   @id
  valueJson String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String?
  passwordHash String
  role         String    @default("ADMIN")
  enabled      Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([enabled])
  @@index([role])
}
