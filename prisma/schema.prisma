generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Candidate {
  id            String            @id @default(cuid())
  name          String
  email         String?
  phone         String?
  targetCompany String?
  targetRole    String?
  serviceStatus String            @default("ACTIVE")
  weakTags      String            @default("[]")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  materials     MaterialAsset[]
  tasks         TrainingTask[]
  sessions      TrainingSession[]
}

model MaterialAsset {
  id          String     @id @default(cuid())
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  type        String
  title       String
  content     String
  source      String     @default("MANUAL")
  createdAt   DateTime   @default(now())

  @@index([candidateId])
}

model CompanyTemplate {
  id               String         @id @default(cuid())
  name             String
  industry         String?
  interviewStyle   String
  competencyModel  String
  commonQuestions  String
  scoringStandard  String
  restrictedTopics String         @default("[]")
  createdAt        DateTime       @default(now())
  tasks            TrainingTask[]
}

model JobTemplate {
  id              String         @id @default(cuid())
  title           String
  category        String
  competencyModel String
  commonQuestions String
  riskQuestions   String
  createdAt       DateTime       @default(now())
  tasks           TrainingTask[]
}

model InterviewerTemplate {
  id                 String         @id @default(cuid())
  type               String         @unique
  name               String
  tone               String
  followUpDepth      Int
  interruptFrequency Int
  challengeIntensity Int
  languageMode       String
  safetyBoundary     String
  createdAt          DateTime       @default(now())
  tasks              TrainingTask[]
}

model TrainingTask {
  id                    String               @id @default(cuid())
  candidateId           String
  candidate             Candidate            @relation(fields: [candidateId], references: [id])
  companyTemplateId     String?
  companyTemplate       CompanyTemplate?     @relation(fields: [companyTemplateId], references: [id])
  jobTemplateId         String?
  jobTemplate           JobTemplate?         @relation(fields: [jobTemplateId], references: [id])
  interviewerTemplateId String?
  interviewerTemplate   InterviewerTemplate? @relation(fields: [interviewerTemplateId], references: [id])
  title                 String
  targetCompany         String
  targetRole            String
  stageConfig           String
  expectedMinutes       Int
  status                String               @default("DRAFT")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  sessions              TrainingSession[]
  aiCalls               AiCallLog[]

  @@index([candidateId])
  @@index([companyTemplateId])
  @@index([jobTemplateId])
  @@index([interviewerTemplateId])
}

model TrainingSession {
  id           String          @id @default(cuid())
  taskId       String
  task         TrainingTask    @relation(fields: [taskId], references: [id])
  candidateId  String
  candidate    Candidate       @relation(fields: [candidateId], references: [id])
  status       String          @default("IN_PROGRESS")
  currentStage String?
  outlineJson  String?
  startedAt    DateTime        @default(now())
  endedAt      DateTime?
  turns        SessionTurn[]
  report       CoachingReport?
  aiCalls      AiCallLog[]
  digitalHumanSessions DigitalHumanSession[]

  @@index([taskId])
  @@index([candidateId])
}

model DigitalHumanSession {
  id                String          @id @default(cuid())
  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  providerId        String?
  modelId           String?
  adapter           String
  mode              String
  providerSessionId String?
  instanceId        String?
  status            String          @default("CONNECTING")
  lastActivityAt    DateTime        @default(now())
  expiresAt         DateTime
  endedAt           DateTime?
  stopReason        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([trainingSessionId])
  @@index([status, lastActivityAt])
  @@index([providerSessionId])
}

model SessionTurn {
  id        String          @id @default(cuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id])
  stage     String
  questionId String?
  question  String
  answer    String
  behaviorSignalsJson String?
  feedback  String?
  createdAt DateTime        @default(now())

  @@index([sessionId])
  @@unique([sessionId, questionId])
}

model CoachingReport {
  id                    String          @id @default(cuid())
  sessionId             String          @unique
  session               TrainingSession @relation(fields: [sessionId], references: [id])
  overallScore          Int
  subScores             String
  perQuestionFeedback   String
  expressionAnalysis    String
  answerQualityAnalysis String
  strategySuggestions   String
  weakTags              String
  nextTrainingPlan      String
  candidateSummary      String
  detailsJson           String          @default("{}")
  createdAt             DateTime        @default(now())
  aiCalls               AiCallLog[]
}

model AiCallLog {
  id               String           @id @default(cuid())
  taskId           String?
  task             TrainingTask?    @relation(fields: [taskId], references: [id])
  sessionId        String?
  session          TrainingSession? @relation(fields: [sessionId], references: [id])
  reportId         String?
  report           CoachingReport?  @relation(fields: [reportId], references: [id])
  capability       String
  provider         String
  latencyMs        Int
  costEstimate     Float
  success          Boolean
  failureReason    String?
  fallbackProvider String?
  createdAt        DateTime         @default(now())

  @@index([taskId])
  @@index([sessionId])
  @@index([reportId])
}

model AiServiceProvider {
  id                     String          @id @default(cuid())
  displayName            String
  providerType           String
  baseUrl                String?
  apiKeyCiphertext       String?
  apiKeyIv               String?
  apiKeyTag              String?
  apiKeyPreview          String?
  credentialsCiphertext  String?
  credentialsIv          String?
  credentialsTag         String?
  credentialsPreviewJson String?
  settingsJson           String          @default("{}")
  enabled                Boolean         @default(true)
  notes                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  models                 AiModelConfig[]

  @@index([providerType])
  @@index([enabled])
}

model AiModelConfig {
  id           String            @id @default(cuid())
  providerId   String
  provider     AiServiceProvider @relation(fields: [providerId], references: [id])
  displayName  String
  modelName    String
  capability   String
  temperature  Float             @default(0.4)
  maxTokens    Int               @default(1200)
  timeoutMs    Int               @default(30000)
  costNote     String?
  settingsJson String            @default("{}")
  enabled      Boolean           @default(true)
  isDefault    Boolean           @default(false)
  isSelected   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([providerId])
  @@index([capability])
  @@index([enabled])
  @@index([isDefault])
  @@index([isSelected])
}
